# Set these in your local .env file. Use a PostgreSQL database for development.
# DATABASE_URL should be the pooled/runtime connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# DIRECT_URL should be the direct, non-pooled connection string used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
