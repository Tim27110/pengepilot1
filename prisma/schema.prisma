generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MockTransaction {
  id          String   @id @default(cuid())
  description String
  amount      Int
  type        String
  category    String
  occurredAt  DateTime
  createdAt   DateTime @default(now())
}
